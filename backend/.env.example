# Server
PORT=4000
NODE_ENV=development

# MongoDB
MONGO_ROOT_DATABASE=waifudoro
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=admin1234
# For local dev (npm run dev):
DATABASE_URL="mongodb://localhost:27017/waifudoro"
# For Docker the URL is auto-constructed in docker-compose.yml — no need to change this

# JWT — must be at least 32 characters each
JWT_SECRET=rAnDoM_sEcReT_kEy_fOr_WaIfUdOrO_dEv_32chars
JWT_REFRESH_SECRET=rAnDoM_rEfReSh_sEcReT_WaIfUdOrO_dEv_32chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS — frontend URL
CORS_ORIGIN=http://localhost:5173

# Optional: Claude AI for waifu chat
ANTHROPIC_API_KEY=your_api_key_here

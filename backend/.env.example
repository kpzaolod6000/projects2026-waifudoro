# Server
PORT=4000
NODE_ENV=development

# MongoDB
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=
DATABASE_URL="mongodb://admin:password@mongodb:27017/waifudoro?authSource=admin"

# JWT — must be at least 32 characters each
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS — frontend URL
CORS_ORIGIN=http://localhost:5173

# Optional: Claude AI for waifu chat
ANTHROPIC_API_KEY=
